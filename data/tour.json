      "hold": 2.5,
      "view": "globe",
      "globe": {
        "from": "home",
        "to": "sojourner",
        "flyStart": 9.5
      },
      "neo": {
        "action": "greet",
        "target": "site",
        "expr": "smile",
        "side": "right"
      },
      "sourceIds": [
        "pathfinder",
        "spirit",
        "opportunity"
      ]
    },
    {
